# Env của vai `serve` + `worker` (production). Chép thành deploy/odyssey-portal-backend.env.
# KHÔNG đặt MIGRATOR_URL ở đây — entrypoint từ chối khởi động (deploy/README.md §1).

ENVIRONMENT=production

# Role portal_api (CRUD bảng shop). Cấp LOGIN bằng tay sau lần migrate đầu (README §2).
DATABASE_URL=postgresql://portal_api:<mật-khẩu>@<host>:5432/portal

# Gốc URL công khai của backend — link tệp/ảnh trong payload Qdrant: {base}/api/v1/public/files/<khoá>.
# Rỗng = không sinh link.
PUBLIC_BASE_URL=https://<domain>

# Kho tệp. AWS S3: để trống S3_ENDPOINT_URL + hai khoá (credential từ IAM role).
S3_ENDPOINT_URL=
S3_BUCKET=shop
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ap-southeast-1
# Route phát tệp trả 307 tới URL kho có hạn. Chỉ bật khi kho mở được từ Internet.
S3_REDIRECT_ENABLED=false

# Qdrant — API key phải trùng service.api_key của Qdrant.
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# Kho tri thức: embed service (dense 1024 + sparse bm25 + ảnh 768).
KB_EMBED_URL=http://embed:8013
KB_SANTA_MODELS_TOKEN=
# Collection = {prefix}_documents và {prefix}_media.
KB_COLLECTION_PREFIX=shop
KB_FILE_MAX_MB=25

# Số job chạy đồng thời trong MỘT worker.
WORKER_BUDGET=12

REDIS_URL=redis://:<mật-khẩu>@redis:6379/0
