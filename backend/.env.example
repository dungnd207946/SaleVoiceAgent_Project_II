# Chép thành `.env` (không commit). Compose, Makefile và Settings đều đọc file này.
#
# ⚠️ MÁY DEV DÙNG CHUNG: dự án khác (`odyssey-portal-backend`) đang giữ 5442/6382/6343/9002/8100
# và network `odyssey-network`. Mọi giá trị dưới đây là của dự án NÀY — đổi cổng thì đổi cả DSN.

COMPOSE_PROJECT_NAME=pj2-backend
PORTAL_DOCKER_NETWORK=pj2-network

# ─── Cổng dev ───────────────────────────────────────────────────────────────
PORTAL_PG_PORT=5452
PORTAL_REDIS_PORT=6392
PORTAL_QDRANT_PORT=6353
PORTAL_QDRANT_GRPC_PORT=6354
PORTAL_MINIO_PORT=9012
PORTAL_MINIO_CONSOLE_PORT=9013
# `make api` (host) và API trong container — khác nhau để chạy được đồng thời.
PORTAL_API_PORT=8110
PORTAL_API_DOCKER_PORT=8111

ENVIRONMENT=development
WORKER_BUDGET=12

# ─── Postgres ───────────────────────────────────────────────────────────────
# HAI DSN, HAI ROLE: migrator (chủ schema, chỉ alembic) và portal_api (runtime).
PORTAL_PG_USER=portal_migrator
PORTAL_PG_PASSWORD=dev
PORTAL_PG_DB=portal
# Migration tạo portal_api NOLOGIN; `make grant-api-dev` cấp mật khẩu này (chỉ dev).
PORTAL_API_DB_USER=portal_api
PORTAL_API_DB_PASSWORD=apidev
DATABASE_URL=postgresql://portal_api:apidev@localhost:5452/portal
MIGRATOR_URL=postgresql://portal_migrator:dev@localhost:5452/portal

# ─── Redis (hạ tầng giữ sẵn, chưa module nào dùng) ──────────────────────────
PORTAL_REDIS_PASSWORD=devredis
PORTAL_REDIS_DB=0
REDIS_URL=redis://:devredis@localhost:6392/0

# ─── Kho tệp (MinIO) ────────────────────────────────────────────────────────
# Cùng cặp khoá là MINIO_ROOT_USER/PASSWORD của container — lệch nhau là 403.
S3_ENDPOINT_URL=http://localhost:9012
S3_BUCKET=shop
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_REDIRECT_ENABLED=false
# Rỗng/localhost = không sinh link công khai cho tệp trong payload Qdrant.
PUBLIC_BASE_URL=

# ─── Kho tri thức ───────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6353
QDRANT_API_KEY=
KB_EMBED_URL=http://localhost:8016
KB_SANTA_MODELS_TOKEN=
KB_COLLECTION_PREFIX=shop
KB_FILE_MAX_MB=25
