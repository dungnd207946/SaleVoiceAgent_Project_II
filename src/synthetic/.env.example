# ═══════════════════════════════════════════════════════════════════════════════
# Customer Agent (CA) — synthetic data generator config
# Copy to src/synthetic/.env and fill in.
#
# CA reuses the same 3 providers as Noble Agent (anthropic / openai / gemini),
# but keeps its own keys/models so you can drive CA with a different model than
# the Noble Agent under test (e.g. CA = GPT-4o-mini, Noble = a fine-tune).
# ═══════════════════════════════════════════════════════════════════════════════

# Which provider drives the CA persona — openai | anthropic | gemini
CA_PROVIDER=openai
CA_MODEL=gpt-4o-mini
CA_TEMPERATURE=0.9
CA_MAX_TOKENS=300

# ── Provider credentials (only the one matching CA_PROVIDER is required) ────

# OpenAI (or any OpenAI-compatible endpoint, e.g. vLLM)
CA_OPENAI_API_KEY=
CA_OPENAI_BASE_URL=

# Anthropic
CA_ANTHROPIC_API_KEY=
CA_ANTHROPIC_BASE_URL=

# Gemini (uses OpenAI-compatible endpoint)
CA_GEMINI_API_KEY=
CA_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
