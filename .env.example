# ═══════════════════════════════════════════════════════════════════════════════
# Noble Voice Agent — Environment Configuration
# Copy to .env and fill in your values. Pydantic reads these → overrides config.py.
# ═══════════════════════════════════════════════════════════════════════════════

# ── STT Backend ──────────────────────────────────────────────────────────────
# sherpa | soniox | qwen3asr | elevenlabs | remote
STT_BACKEND=soniox

# Soniox (cloud)
SONIOX_API_KEY=
SONIOX_MODEL=stt-rt-v4

# Sherpa-ONNX (local) — only needed when STT_BACKEND=sherpa.
# Requires the optional dep: pip install -e ".[stt-sherpa]"  (sherpa-onnx>=1.10)
# SHERPA_MODEL_DIR: dir holding the encoder/decoder/joiner ONNX + tokens.txt (e.g. models/hynt-bilingual).
# SHERPA_MODEL_QUANTIZE: false → encoder-*.onnx (excluding *.int8.onnx); true → encoder-*.int8.onnx.
#   The ONNX filename stem is auto-discovered by globbing SHERPA_MODEL_DIR (>1 match → error).
# SHERPA_PRESERVE_CASE: hynt-bilingual emits ALL-CAPS; false → sentence-case (lower+capitalize), true → raw caps.
# Auto-provision: when SHERPA_MODEL_DIR lacks the model files, they are pulled from
# SHERPA_HF_REPO at SHERPA_HF_REVISION using HF_TOKEN (CD: models/ is gitignored). Mount a volume to cache.
SHERPA_MODEL_DIR=models/hynt-bilingual
SHERPA_MODEL_QUANTIZE=false
SHERPA_PRESERVE_CASE=false
SHERPA_HF_REPO=NobleX-AI/santa-stt
# HF branch/tag to pull NobleX-AI/santa-stt from
SHERPA_HF_REVISION=prod
HF_TOKEN=
# greedy_search (default) | modified_beam_search (more accurate, ~N× CPU).
# A non-empty SHERPA_HOTWORDS_FILE forces modified_beam_search regardless.
SHERPA_DECODING_METHOD=greedy_search
SHERPA_MAX_ACTIVE_PATHS=4
SHERPA_HOTWORDS_FILE=data/hotwords.txt

# Qwen3-ASR — only needed when STT_BACKEND=qwen3asr
# dashscope | vllm
QWEN3ASR_MODE=dashscope
QWEN3ASR_API_KEY=
# intl (Singapore) | cn (Beijing)
QWEN3ASR_REGION=intl

# ElevenLabs Scribe — shared key with TTS (only needed when STT_BACKEND=elevenlabs)
ELEVENLABS_API_KEY=

# ── Remote STT/TTS services (backend "remote") ────────────────────────────────
# Agent worker: đặt remote để KHÔNG load model nặng trong process worker.
# STT_BACKEND=remote
# TTS_BACKEND=remote
# URL đầy đủ client kết nối (đổi sang ws://<gpu-host>:<port>/... khi tách máy GPU,
# hoặc wss://... khi đi qua Internet sau reverse-proxy TLS).
STT_SERVICE_URL=ws://127.0.0.1:8770/stt
TTS_SERVICE_URL=ws://127.0.0.1:8771/tts
# Server bind (dùng bởi noble-stt-service / noble-tts-service).
STT_SERVICE_HOST=0.0.0.0
STT_SERVICE_PORT=8770
TTS_SERVICE_HOST=0.0.0.0
TTS_SERVICE_PORT=8771
# Engine the TTS service (noble-tts-service) uses INTERNALLY — the worker stays remote.
#   vieneu      → transformers backbone + token streaming, GPU loaded in THIS service
#   vieneu_vllm → client to a separate vLLM server (run scripts/run_vllm_tts.sh first);
#                 the GPU backbone lives in vLLM, this service runs only the codec.
# vieneu | vieneu_vllm
TTS_SERVICE_ENGINE=vieneu
# Tùy chọn: bearer token chống truy cập trái phép khi service mở ra mạng. Rỗng = tắt.
VOICE_SERVICE_AUTH_TOKEN=

# ── TTS Backend ──────────────────────────────────────────────────────────────
# vieneu | vieneu_vllm | elevenlabs | remote
TTS_BACKEND=elevenlabs

# ElevenLabs (cloud)
ELEVENLABS_TTS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_TTS_LANGUAGE_CODE=vi
ELEVENLABS_TTS_STABILITY=0.5
ELEVENLABS_TTS_SIMILARITY_BOOST=0.75
ELEVENLABS_TTS_SPEED=1.0

# VieNeu (local GGUF) — only needed when TTS_BACKEND=vieneu
# path to VieNeu-TTS GGUF model dir or HF repo
VIENEU_BACKBONE_REPO=
# HF branch/tag for the NobleX-AI backbone repo (codec repo stays default)
VIENEU_HF_REVISION=prod
VIENEU_VOICE_ID=
# Safetensors backbone acceleration (santa-tts on cuda). dtype: bfloat16 (default,
# uses tensor cores) | float16 | float32. compile: torch.compile the generate loop —
# off by default (HF generate graph-breaks → ~no gain on this path; left as a knob).
VIENEU_BACKBONE_DTYPE=bfloat16
VIENEU_COMPILE_BACKBONE=false
# Token-level streaming: stream backbone tokens into the codec sink so first audio
# arrives in ~0.3-0.5s instead of after full generation (~4s). ON by default; same
# audio contract. Set false to roll back to the one-shot infer_stream path.
NOBLE_TTS_STREAMING=true
# LiveKit output playout buffer (ms). Bigger buffer bridges the ~300 ms per-clause
# synth gap at a sentence seam (no stutter). Does NOT delay first audio; barge-in is
# still instant because _handle_interrupt calls audio_output.clear().
NOBLE_TTS_OUTPUT_QUEUE_MS=800

# VieNeu via vLLM — only needed when TTS_BACKEND=vieneu_vllm. The agent worker is a
# CLIENT to a SEPARATE vLLM OpenAI server (started by scripts/run_vllm_tts.sh) that
# streams <|speech_N|> tokens; those tokens feed the same codec sink. The worker
# does NOT load the GPU backbone (vLLM owns it) — only the ONNX codec + tokenizer +
# presets. The server MUST run on a host WITHOUT the CUDA toolkit/nvcc with:
#   VLLM_USE_FLASHINFER_SAMPLER=0 VLLM_ATTENTION_BACKEND=FLASH_ATTN vllm serve ... --enforce-eager
VIENEU_VLLM_URL=http://localhost:8000
VIENEU_VLLM_MODEL=NobleX-AI/santa-tts
VIENEU_VLLM_TEMPERATURE=1.0
VIENEU_VLLM_TOP_K=50
# output budget per clause (1024 ≈ 20s audio). Clamped to fit the context.
VIENEU_VLLM_MAX_TOKENS=1024
# MUST match the server's --max-model-len. The client clamps max_tokens so
VIENEU_VLLM_MAX_MODEL_LEN=2048
                                  # len(prompt)+max_tokens ≤ this — else vLLM returns HTTP 400 → no audio.
# REQUIRED — without it the model emits EOS immediately → empty audio
VIENEU_VLLM_MIN_TOKENS=50

# Thinking mode. ENABLE_THINKING (off by default): does the model GENERATE
# thinking. false → send each provider's disable kwarg AND strip leaked
# <think>...</think> everywhere (incl. history). true → model thinks; thinking
# is KEPT in history (forwarded to the LLM) but stripped from TTS and eval.
# (The OPENAI-slot disable kwarg is the vLLM/Qwen `chat_template_kwargs`; if
# OPENAI_BASE_URL points at the real OpenAI API, leave this true to avoid 400.)
NOBLE_LLM_ENABLE_THINKING=false
# Ép vòng LLM ĐẦU mỗi lượt phải gọi tool (tool_choice=required; chỉ provider OpenAI-compat:
# openai/vllm/dashscope; lượt xã giao thoát qua tool no_lookup_needed). Đo 2026-08-27: qwen3.7-flash
# bỏ tool ở ~44% lượt rồi tự nói giá — bật cờ này đưa về 0 (+~1 s/lượt). Cần thinking OFF với dashscope.
LLM_FORCE_TOOL_FIRST_ROUND=false
# SHOW_THINKING: chat-UI tester only (debug). true → show <think> in the chat
# tester. TTS never speaks thinking regardless. Only meaningful when
# ENABLE_THINKING=true.
NOBLE_LLM_SHOW_THINKING=false

# ── LLM Providers (default chain: Anthropic → OpenAI → DashScope → Gemini) ──
# At least one provider must be set. In the refactor (USE_REFACTOR_CORE=true),
# Anthropic becomes primary when ANTHROPIC_API_KEY is set — chat mode opts
# into Claude for accuracy; OpenAI/Gemini remain as fallback. Legacy voice
# flow keeps its own Qwen → Gemini → OpenAI order.

# ── Per-path primary pin ──
# Value MUST match one <P>_MODEL below → that provider runs first for that path;
# the rest still fall back. Empty / no match → default chain order.
# Default = Gemini 2.5 Flash (fast + grounded — chosen after benchmarking).
# Comments stay on their OWN lines (never inline) — env_file/naive parsers do
# not strip inline comments, which corrupts the value.
# main agent (live turn)
NOBLE_AGENT_MODEL=gemini-2.5-flash
# Tên hiển thị của agent trong prompt + câu chào (mặc định Luna).
NOBLE_AGENT_NAME=Luna
# async summary
NOBLE_SUMMARY_MODEL=gemini-2.5-flash
# semcache predictor + sandbox
NOBLE_SEMCACHE_MODEL=gemini-2.5-flash
# follow-up suggestion chips (chat). MUST be pinned — unpinned → default chain
# order (anthropic → openai). For lower cost, pin to your DashScope model
# (e.g. qwen3.x-flash) once DASHSCOPE_* is enabled below; prod runs on qwen.
NOBLE_SUGGESTIONS_MODEL=gemini-2.5-flash

# Anthropic / Claude (refactor primary when set — chat mode, accuracy-first)
# Two paths:
#   (a) Pay-per-token: get key at https://console.anthropic.com/, leave BASE_URL blank.
#   (b) Use Claude Max subscription via Meridian proxy (no API spend):
#       1. npm install -g @rynfar/meridian && claude /login
#       2. scripts/start_meridian.sh   (sets MERIDIAN_PASSTHROUGH=true)
#       3. Uncomment lines below — any non-empty key works (Meridian ignores it
#          unless MERIDIAN_API_KEY is set on the proxy side).
# ANTHROPIC_API_KEY=meridian-no-auth
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_BASE_URL=http://127.0.0.1:3456

# Gemini (primary)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Three DISTINCT OpenAI-compatible slots (no shared OPENAI_* template). Each is
# its own provider in the chain, built when its key/model is set; pick the active
# one per path via NOBLE_AGENT_MODEL = that slot's model name.
#   openai → OPENAI_*     (provider "openai")     — hosted OpenAI API
#   local  → VLLM_*       (provider "vllm")        — self-host vLLM
#   qwen   → DASHSCOPE_*  (provider "dashscope")   — Alibaba DashScope

# OpenAI API (built when OPENAI_API_KEY set). Default base_url api.openai.com →
# client applies real-OpenAI shaping (max_completion_tokens, temperature=1,
# reasoning_effort). Point base_url elsewhere only for an Azure/proxy OpenAI.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-nano-2026-03-17
# none | low | medium | high
OPENAI_REASONING_EFFORT=none

# vLLM local self-host (OpenAI-compatible). Built when VLLM_MODEL is set; empty =
# disabled. When set, vLLM also leads the default fallback order and Anthropic
# moves to the safety tail.
VLLM_BASE_URL=http://localhost:8000/v1
# e.g. qwen3-2507-unified — set to enable the local provider; empty = disabled
VLLM_MODEL=
# vLLM ignores it, but the openai SDK requires non-empty
VLLM_API_KEY=EMPTY

# Qwen / Alibaba DashScope (OpenAI-compat cloud). Built when DASHSCOPE_API_KEY set.
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_MODEL=qwen3.5-flash

# AWS Bedrock — Amazon Nova (set LLM_PROVIDER=bedrock to use as primary)
# LLM_PROVIDER=openai                 # openai | bedrock
# BEDROCK_REGION=ap-southeast-1
# BEDROCK_MODEL=apac.amazon.nova-lite-v1:0
# BEDROCK_ACCESS_KEY_ID=              # optional — falls back to boto3 chain
# BEDROCK_SECRET_ACCESS_KEY=          # optional — falls back to boto3 chain

# ── Storage ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# ── Search infra: embed service + KB Qdrant (kb_search + send_media) ─────────
# Both tools run retrieval IN-PROCESS against these two endpoints; the
# query_rag:8016 / query_media:8015 services they used to POST are retired.

# EMBED_BACKEND picks the dense backend: gemini | service | hf. EMBED_MODEL empty =
# backend default. EMBED_DIM must equal the collection's dense vector size.
# ⚠ Must match what ingest indexed with — a different model is a different vector
# space, so scores become noise with no error.
EMBED_BACKEND=gemini
EMBED_MODEL=
EMBED_DIM=1024
EMBED_TIMEOUT=30.0
# Sparse (BM25) runs in-process via fastembed — verified byte-identical to the embed
# service's sparse leg. Must equal the model ingest used or the term ids miss.
EMBED_SPARSE_MODEL=Qdrant/bm25
# Only visual (SigLIP2 text tower) still needs the service. Empty = send_media
# searches on dense text alone; everything else works without it.
EMBED_SERVICE_URL=

# THE app's Qdrant — holds `<tenant>_documents` / `<tenant>_media`. Full setup +
# the two infra prerequisites: docs/handoff/qdrant-access.md
#   in-VPC, same EC2 as Qdrant → http://odyssey-portal-backend-qdrant-1:6333
#   in-VPC, different host     → http://10.110.43.147:6333  (needs a published host
#                                port + an inbound 6333 SG rule, neither exists yet)
#   outside the VPC (dev only) → http://127.0.0.1:16433 via SSM port-forward
# ⚠ A `127.0.0.1`/`172.17.0.1` value is local to the host that reads it — copying it
#   to another machine points at that machine's own loopback/bridge and finds nothing.
# The legacy `qdrant`/`hipporag` backends read this same URL but look for their own
# clone collection (QDRANT_COLLECTION), which does not exist here.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_TIMEOUT=10.0

# THRESHOLD/MIN_SCORE are RRF-scaled, not cosine — raising them reduces how many
# hits/images survive. THRESHOLD also shifts with the number of branches fused
# (visual only joins when EMBED_SERVICE_URL is set), so leave it at 0 and cap with
# TOP_K. CACHE_TTL is not invalidated by an ingest (0 disables).
MEDIA_SEARCH_TOP_K=10
MEDIA_SEARCH_THRESHOLD=0.0
MEDIA_SEARCH_CACHE_TTL=300.0
KB_SEARCH_TOP_K=5
KB_SEARCH_MIN_SCORE=0.0

# Shared bearer for STT / TTS / embed / Qdrant.
SANTA_MODELS_TOKEN=

# SP-E Odyssey data plane (contract C4, Fixed-store per N9). OFF by default.
#   POSTGRES_DSN       — runtime conn = the SHARED app role (non-owner, non-superuser,
#                        NOT BYPASSRLS). The RLS `agent_runtime` policy scopes each txn
#                        to a tenant via set_config('app.current_tenant', …, true).
#                        Password from `noble-tenant pg-ensure-app-role`.
#   POSTGRES_ADMIN_DSN — superuser conn used ONLY by `noble-tenant pg-apply-schema` /
#                        `pg-ensure-app-role` / `pg-provision` / `pg-deprovision`
#                        (never on the turn path).
#   POSTGRES_APP_ROLE  — shared app role name; MUST differ from every tenant_id
#                        (else the Portal `tenant_isolation`/current_user policy would
#                        match it by accident). Default: odyssey_agent.
#   POSTGRES_SERVER_DSN — DSN KHÔNG chứa user/password (chỉ host:port/db). Worker
#                        lắp role+password per-tenant (nhận từ gateway qua X-PG-Role/
#                        X-PG-Password) vào đây để dựng pool riêng (`pool_for_tenant`).
#                        Rỗng ⇒ pool_for_tenant luôn fallback về shared POSTGRES_DSN.
# Local dev PG: `docker compose -f docker-compose.pg.yml up -d`.
POSTGRES_ENABLED=false
# POSTGRES_DSN=postgresql://odyssey_agent:<password>@localhost:5432/odyssey
# POSTGRES_ADMIN_DSN=postgresql://sp_admin:sp_admin_pw@localhost:5432/odyssey
# POSTGRES_APP_ROLE=odyssey_agent
# POSTGRES_SERVER_DSN=postgresql://localhost:5432/odyssey

# ── Billing usage metering ────────────────────────────────────────────────
# Đo tiêu thụ để Portal tính tiền: token LLM (4 cột rời nhau input/output/
# cache_write/cache_read) + thời lượng STT/TTS/VAD/speaker-verify + một dòng
# `call` mỗi phiên voice → INSERT `billing.usage_events`.
# Bảng do Portal sở hữu; agent chỉ ghi thêm (không UPDATE/DELETE) và KHÔNG biết giá.
# Cần POSTGRES_ENABLED=true. Bảng + GRANT + RLS đã có trên DB `portal` từ
# 2026-08-18 — xem §14 docs/handoff/agent-postgres-billing-write-contract.md.
# TẮT ⇒ không đo gì VÀ không gửi `stream_options` cho LLM (cờ đó có thể làm
# endpoint không hỗ trợ trả 400 = non-transient → rụng provider).
BILLING_METERING_ENABLED=false

# ── Data provider ─────────────────────────────────────────────────────────
# pg_kb = the sole provider: the Postgres KB (tenant_data.projects/zones/units/
#   documents/media). Needs POSTGRES_DSN + POSTGRES_ENABLED=true.
NOBLE_DATA_SOURCE=pg_kb           # pg_kb

# Tenant bundle selected at boot: tenants/<TENANT_ID>/manifest.toml + persona/
# (SaaS Phase 3). Only "noble" ships today; default is fine for all deploys.
TENANT_ID=noble
# discover_projects: number of projects returned per page (funnel top-K)
NOBLE_DISCOVER_PAGE_SIZE=5

# ── RAG: Embeddings ──────────────────────────────────────────────────────────
# FlatStore loads e5-large (1024d) in-process via fastembed — no vector DB or
# embedding sidecar needed. Dimension is used by the memory_router fallback.
EMBEDDING_DIMENSION=1024

# ── RAG: Backend selection ───────────────────────────────────────────────────
# flat_store (default) | qdrant | hipporag | hipporag_kb | grep_faq | empty
# NOBLE_RAG_BACKEND=flat_store
#
# hipporag = HippoRAG 2 graph-RAG. Builds a knowledge graph (phrase + passage
# nodes) OFFLINE from the Qdrant clone via LLM OpenIE, then at query-time runs
# Personalized PageRank on that static graph (numpy only, NO LLM) and RRF-fuses
# with the hybrid ranking. Seeds come from the qdrant hybrid, so it requires the
# qdrant clone to be populated. Degrades to the plain qdrant result if the graph
# artifact is missing. Build / update the graph with:
#     noble-rag-sync                # reconcile clone + INCREMENTAL KG update
#                                   # (only NEW chunks, by content_hash, hit the LLM)
#     noble-rag-sync --renew-graph  # rebuild the whole KG from scratch
# HIPPORAG_GRAPH_PATH=data/hipporag/graph.json
# HIPPORAG_PPR_ALPHA=0.5            # PPR damping
# HIPPORAG_PPR_ITERS=30            # power-iteration steps
# HIPPORAG_SEED_K=8                # hybrid hits used to seed PPR
# HIPPORAG_TOP_K=5                 # passages returned after fuse
# HIPPORAG_OPENIE_MAX_TOKENS=1024  # build-time OpenIE completion cap
# HIPPORAG_OPENIE_MODEL=           # pin the OpenIE provider independently of the
#                                  # main agent (must equal one of the <P>_MODEL
#                                  # values, same scheme as NOBLE_AGENT_MODEL).
#                                  # Empty → fall back to the NOBLE_AGENT_MODEL pin.
# Note: when kb_search is called with a project_filter, the hipporag output is
# scoped to that project (PPR still spreads through cross-project shared entities
# for recall, but a scoped query never surfaces another project's passage).
#
# Sparse triple-seed (HippoRAG 2 dual seeding, embedding-based, NO LLM). Besides
# the dense passage seeds, embed each extracted TRIPLE ("subject relation object")
# and, at query-time, cosine-match the query against those triples → the top
# triples seed PPR at BOTH their entity nodes (captures relational queries like
# "dự án nào ở Hải Phòng" that bare-entity matching misses). Runs IN PARALLEL with
# the hybrid search (asyncio.gather) so it adds ~no wall-clock. Triple embeddings
# are built by noble-rag-sync (sidecar <graph>.triple_emb.npz); missing → no-op.
# NOTE: the triple index requires triples, which older graphs don't have — run
#       `noble-rag-sync --renew-graph` once to (re-)extract them.
# HIPPORAG_SPARSE_SEED_ENABLED=false
# HIPPORAG_SPARSE_SEED_TOP_M=5      # how many TRIPLES to match (each seeds up to 2 entities)
# HIPPORAG_SPARSE_SEED_WEIGHT=0.3  # PPR restart mass share for sparse seeds (0..1)
# Seed score thresholds — applied AFTER top-K, BEFORE the dense/sparse mix, so a
# low-similarity seed never injects noise into PPR. passage = qdrant hybrid score,
# phrase = triple cosine. 0.0 = keep every top-K seed (no filtering).
# HIPPORAG_PASSAGE_SEED_THRESHOLD=0.0
# HIPPORAG_PHRASE_SEED_THRESHOLD=0.0

# HippoRAG artefact do Portal ghi (chỉ backend `hipporag_kb` đọc). Rỗng ⇒ không tải
# gì ⇒ backend degrade về đúng kết quả `kb_service`. Bucket là bucket của Portal,
# KHÔNG phải TENANT_BUCKET của kho bundle legacy.
# HIPPORAG_ARTEFACT_ENDPOINT=
# HIPPORAG_ARTEFACT_BUCKET=
# HIPPORAG_ARTEFACT_ACCESS_KEY=
# HIPPORAG_ARTEFACT_SECRET_KEY=
# HIPPORAG_CACHE_DIR=/var/lib/noble/hipporag
#
# hipporag_kb = HippoRAG trên collection PER-TENANT đang sống (`<tenant>_documents`),
# khác `hipporag` vốn đọc clone legacy `noble_kb_hybrid` không tồn tại trên deployment
# này. Seed lấy từ đúng đường `kb_service`; graph do Portal build và ghi lên kho tệp
# (KB_HIPPO_ENABLED bên đó). Thiếu artefact ⇒ trả đúng kết quả `kb_service`.

# HippoRAG triple embedding store: "local" (numpy sidecar, default) | "qdrant"
# (dedicated collection built by noble-rag-sync alongside the npz). Query cascade
# when "qdrant": Qdrant → local npz → sparse-seed off. Rollback = set back to local.
HIPPORAG_TRIPLE_STORE=local
QDRANT_TRIPLE_COLLECTION=noble_kb_hipporag_triples

# ── Email (escalation notifications) ─────────────────────────────────────────
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_DEFAULT_FROM=luna@noblex.vn

# ── Business ─────────────────────────────────────────────────────────────────
NOBLE_HOTLINE=1800 6112
NOBLE_WORKING_HOURS=8:00-21:00

# ── Server ───────────────────────────────────────────────────────────────────
WS_HOST=0.0.0.0
WS_PORT=8766
# In-process /chat admission cap (server/admission.py); <=0 = unbounded. Chat is I/O-bound so keep wide — reject + readiness-503 at the ceiling; active/rejected is the signal a future KEDA autoscaler scales on.
CHAT_MAX_CONCURRENT_SESSIONS=200

# ── WebRTC (ICE) ─────────────────────────────────────────────────────────────
# RTC_STUN_URL=stun:stun.l.google.com:19302
# RTC_TURN_URL=
# RTC_TURN_CREDENTIAL=

# ── LiveKit (transport migration — see LIVEKIT_MIGRATION.md) ────────────────
# TRANSPORT_BACKEND selects the audio transport path. Keep `aiortc` until
# Phase 9 cleanup; `livekit` enables the new RoomSession worker path.
# aiortc | livekit
TRANSPORT_BACKEND=aiortc

LIVEKIT_URL=ws://localhost:7880
# Public wss URL browsers connect to via nginx/TLS proxy. Leave empty to
# reuse LIVEKIT_URL (ok for local dev). Example prod value:
#   LIVEKIT_PUBLIC_URL=wss://hotline-agent.noble.vn/livekit/rtc
LIVEKIT_PUBLIC_URL=
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=__REPLACE_ME__
LIVEKIT_AGENT_NAME=noble-hotline-agent
WORKER_MAX_CONCURRENT_SESSIONS=50
# Public GET /livekit/token (dev browser tester). Prod=false → app dùng
# POST /api/v1/app/session channel=voice để mint token.
LIVEKIT_TOKEN_PUBLIC=false

# ── Optional: Local ML Models ────────────────────────────────────────────────
# SMART_TURN_ENABLED=false
# SMART_TURN_MODEL_PATH=              # path to smart-turn ONNX model
# GENDER_MODEL_DIR=                   # path to gender detection model

# ── Optional: Remote hosting mode (embed + gender sidecars) ─────────────────
# Default (both empty) = in-process models loaded into agent — SAME behavior
# as before this feature existed. Set these ONLY when you're hosting embed
# and/or gender as separate services (see infra/runpod/SETUP.md).
#
# URL pattern depends on deployment scenario — pick ONE and uncomment:
#
# Pattern A — Stable DNS (production, needs TLS + DNS zone):
# EMBED_REMOTE_URL=https://embed.hotline.noble.vn
# GENDER_REMOTE_URL=https://gender.hotline.noble.vn
# OPENAI_BASE_URL=https://llm.hotline.noble.vn/v1
#
# Pattern B — Docker service DNS (single-host docker-compose / VPS):
# EMBED_REMOTE_URL=http://embed:8091
# GENDER_REMOTE_URL=http://gender:8092
# OPENAI_BASE_URL=http://vllm:8000/v1
#
# Pattern C — RunPod public proxy (separate pod per service):
# EMBED_REMOTE_URL=https://<pod-id>-8091.proxy.runpod.net
# GENDER_REMOTE_URL=https://<pod-id>-8092.proxy.runpod.net
# OPENAI_BASE_URL=https://<pod-id>-8000.proxy.runpod.net/v1
#
# Pattern D — Internal hosted embed service (Bearer-auth):
# ⚠ EMBED_REMOTE_* is flat_store/_Embedder only, and its wire contract
#   ({"texts","is_query"}) is REJECTED by the current embed service (400/422). Leave
#   unset; kb_search/send_media use EMBED_SERVICE_URL with the `side` contract.
# EMBED_REMOTE_URL=http://10.50.12.70:8013
# EMBED_REMOTE_TOKEN=<bearer-token>  # sent as `Authorization: Bearer <token>`; empty = no auth
#
# Tunables (safe defaults — override only when needed):
# EMBED_REMOTE_TIMEOUT=10.0           # seconds; e5-large batch ~100ms/req warm
# GENDER_REMOTE_TIMEOUT=3.0           # seconds; Wav2Vec2 predict ~80ms/req
#
# LiveKit worker health port — set to 8082 if host already uses 8081 (RunPod):
# LIVEKIT_WORKER_PORT=8081

# ── Optional: Telephony (Asterisk/FreePBX) ───────────────────────────────────
# TELEPHONY_ENABLED=false
# ASTERISK_HOST=voip.noble.vn
# ASTERISK_ARI_PORT=8088
# ASTERISK_ARI_USERNAME=noble-agent
# ASTERISK_ARI_PASSWORD=

# Outbound call (scripts/make_outbound_call.py). These defaults match the
# current Noble FreePBX install — override only if trunk/context changes.
# ASTERISK_SIP_TRUNK=NobleX-88801441
# ASTERISK_OUTBOUND_CALLERID=18006112
# ASTERISK_OUTBOUND_CONTEXT=noble-agent-outbound
# ASTERISK_OUTBOUND_TIMEOUT=30

# SMS via SIP MESSAGE over the PJSIP trunk (scripts/send_test_sms.py).
# `dry_run` just logs payload; `sip` sends via ARI — delivery to a real
# cellphone only works if the trunk provider routes MESSAGE to an SMS gateway.
# SMS_ENABLED=false
# SMS_BACKEND=dry_run        # dry_run | sip
# SMS_FROM=18006112

# ── Optional: Tuning ─────────────────────────────────────────────────────────
# BUFFER_MODE=clause                  # clause | sentence
# INTERRUPT_MODE=immediate            # immediate | finish_current
# EMOTION_TAGS_ENABLED=false
# HEALTH_CHECK_INTERVAL=30
# MAX_WS_CONNECTIONS=100
# MAX_WS_PER_IP=5

# ── Part 7: NobleX app integration (bubble chat/voice) ─────────────────────────
# Server-to-server key backend NobleX dùng để provision phiên agent.
# NOBLE_APP_API_KEY=
# Prod set true để WS /chat bắt buộc connect-token. Dev để trống/false cho chat tester.
# CHAT_WS_REQUIRE_TOKEN=false
# APP_CONNECT_TOKEN_TTL_SECONDS=120
# Public wss base, vd wss://hotline-agent.noble.vn (trống = trả path, backend tự ghép host).
# APP_WS_PUBLIC_BASE=

# ── Semantic response cache (refactor core only) ────────────────────────────
# After each turn, predict N next user queries and ghost-run the agent for each
# in a sandbox (no Redis writes). On the next turn, embed the user query
# and look it up against cached predicted queries with cosine similarity.
# On hit, replay the cached chain instead of calling the LLM again.
# Modes per entry: "full" (cached run ended with a normal response) or
# "partial" (cached run hit a write-tool — on hit, live-dispatch those tool_calls
# and resume the LLM loop).
NOBLE_SEMCACHE_ENABLED=false
NOBLE_SEMCACHE_NUM_PREDICTIONS=5
NOBLE_SEMCACHE_THRESHOLD=0.85
NOBLE_SEMCACHE_EMBED_MODEL=intfloat/multilingual-e5-small
NOBLE_SEMCACHE_PREDICTOR_TEMPERATURE=0.8
NOBLE_SEMCACHE_HISTORY_LOOKBACK=8

# ── Unified agent (single-agent rewrite) ──────────────────────────────────
# false  → behave as before (legacy or refactor depending on USE_REFACTOR_CORE)
# true   → use src/noble_agent/ — single-agent prompt + 12 tools
USE_UNIFIED_AGENT=false

# Number of recent messages kept verbatim in history after async summary fires.
NOBLE_SUMMARY_KEEP_TAIL=4

# After a summary is persisted, fire a background throwaway LLM call replaying
# the next turn's exact request so the provider's prompt cache is warm before
# the next live turn (kills the post-summary latency spike). Provider-agnostic.
NOBLE_SUMMARY_WARM_CACHE=true

# The DB project registry (tool-schema project-code enums + the prompt project
# table) is warmed once at boot. To pick up project-registry changes without
# a restart, the start of each new call re-warms it — but only if the last warm
# was longer ago than this many seconds (debounce, so a burst of calls shares
# one DB query). 0 disables the per-call refresh (restart to update).
NOBLE_PROJECT_REGISTRY_REFRESH_SEC=120

# Simulated caller for testing chat / LiveKit (both open with no real phone).
# NOBLE_SIMULATE_PHONE=true → fill an empty session phone at start.
# NOBLE_SIMULATE_PHONE_NUMBER: pin a fixed caller phone (empty → random). Set one
#   present in tenant_data.contacts to exercise the DB profile lookup
#   (telephony scenario). NOBLE_SIMULATE_CUSTOMER: JSON of Customer fields seeded
#   before the first-turn bootstrap (app-client scenario, mirrors set_customer);
#   empty → phone only. The DB bootstrap still runs and wins over seeded values.
# Examples:
#   NOBLE_SIMULATE_PHONE_NUMBER=0912000000
#   NOBLE_SIMULATE_CUSTOMER={"name":"Hùng","gender":"M","project_interest":"NPTTL"}
NOBLE_SIMULATE_PHONE=true
NOBLE_SIMULATE_PHONE_NUMBER=
NOBLE_SIMULATE_CUSTOMER=

# ── User snapshot memory (always on when a real phone is present) ──
# USER_MEMORY_SHORT_TERM_TURNS=6      # last K prior-session turns injected at bootstrap
# USER_MEMORY_SINCE_DAYS=30           # how far back to look for the prior session
# SNAPSHOT_LOCK_WAIT_SEC=10           # bootstrap waits at most this for an in-flight merge
# SNAPSHOT_LOCK_TTL_SEC=60            # merge lock TTL

# ── STT input gate (prevents noise from producing garbage text) ───────────────
# off   → passthrough (original behaviour, no gate)
# rms   → per-frame RMS energy threshold (replaces removed AUDIO_GUARD_FRAMES_GATE_ENABLED)
# vad   → Silero VAD drives the gate (VAD already drives interrupts; this adds STT blocking)
# All modes support a K-chunk pre-roll lookback so speech onset is never clipped.
STT_INPUT_GATE_MODE=off
AUDIO_GATE_PREROLL_CHUNKS=3
# rms mode tuning
AUDIO_GATE_MIN_RMS=160
AUDIO_GATE_REQUIRED_CONSECUTIVE=3
AUDIO_GATE_BARGE_IN_RMS=2400
# vad mode tuning
STT_VAD_GATE_HANGOVER_MS=300
# (rms/vad) max synthetic silence fed to STT after a pending utterance so its endpoint fires; 0 = off
STT_GATE_KEEPALIVE_MAX_SEC=2.0

# ── VAD (Silero) ─────────────────────────────────────────────────────────────
# Model comes from the pinned `silero-vad` wheel (no torch.hub / network at boot).
# VAD_CHUNK_MS is fixed by Silero v5+ (512 samples @ 16 kHz) — anything else fails at load.
VAD_CHUNK_MS=32
VAD_THRESHOLD=0.7                 # Silero speech probability → is_speech
VAD_INTERRUPT_CONFIRM_CHUNKS=3    # consecutive speech chunks (96 ms) to confirm barge-in
# Min RMS (int16 scale) a Silero speech chunk must reach to count toward an
# interrupt while agent audio is actually playing — rejects quiet AEC echo
# residual that would otherwise make the agent cut itself off. No effect before
# playback starts (LLM still thinking). Lower if soft-spoken callers can't barge
# in (the agent logs "rejected by RMS floor" once per turn); 0 = off.
BARGE_IN_RMS_THRESHOLD=1500

# ── Speaker policy ────────────────────────────────────────────────────────────
# off | single | multi. single = enrolls ONE session identity and gates barge-in
# on it; a stranger's final is NOT dropped (fail-open, it still reaches the
# agent) — a stranger just can't interrupt while the agent is talking, and the
# evidence-based mismatch-streak valve (SPV_MISMATCH_STREAK_MAX) can eventually
# drop the asker and reopen the floor. multi = turn-taking; only the current
# asker may interrupt agent TTS.
SPEAKER_MODE=off
# SPEAKER_VERIFICATION_ENABLED is deprecated — legacy true resolves to single.
# Remote embed service (preferred): set URL → uses noble-speaker-service HTTP /embed.
# Empty URL → falls back to local sherpa SpeakerEmbeddingExtractor (auto-provisioned from HF).
SPEAKER_REMOTE_URL=
SPEAKER_REMOTE_TIMEOUT=3.0
SPEAKER_REMOTE_TOKEN=
# Local model (used when SPEAKER_REMOTE_URL is empty)
SPEAKER_MODEL_DIR=models/speaker
SPEAKER_MODEL_NAME=3dspeaker_speech_campplus_sv_zh-cn_16k-common.onnx
SPEAKER_HF_REPO=csukuangfj/speaker-embedding-models
SPEAKER_HF_REVISION=main
# Verification thresholds
SPEAKER_MATCH_THRESHOLD=0.5
SPEAKER_MIN_ENROLL_SEC=1.0
# Speaker registry + fast barge-in (spec 2026-09-03).
# Ngưỡng gốc là SPEAKER_MATCH_THRESHOLD ở trên; hai dòng BONUS/MARGIN chỉ siết thêm.
SPV_PROBE_MARKS_SEC=0.25,0.4,0.6,0.9,1.3   # mốc embed tích luỹ; mốc đầu = độ trễ ngắt tốt nhất
SPV_PROBE_BONUS=0.15,0.1,0.05,0,0          # siết thêm cho từng mốc, phải cùng số phần tử
SPV_PROBE_TAIL_WINDOW_SEC=1.5              # hết mốc → cửa sổ trượt (bắt người chen giữa utterance)
SPV_PROBE_TAIL_HOP_SEC=1.0
SPV_ENROLL_WINDOW_SEC=1.5                  # cửa sổ trượt khi enroll
SPV_ENROLL_HOP_SEC=0.75
SPV_ENROLL_CONSENSUS_SIM=0.5               # 2 cửa sổ coi là cùng giọng khi cosine ≥ ngưỡng này
SPV_ENROLL_MIN_CLUSTER=2                   # cụm nhỏ hơn → KHÔNG enroll (thà rỗng còn hơn rác)
SPV_ADAPT_MARGIN=0.1                       # siết thêm khi GHI centroid; 0 = tắt
SPV_MAX_IDENTITIES=4                       # cap danh tính mỗi phiên
SPV_MAX_CENTROIDS=10
SPV_MIN_MATCH_PROBE=2                      # probe phải khớp ≥ N centroid mới tính speaker (kẹp theo cỡ tập)
SPV_MIN_MATCH_IDENTIFY=1                   # identify() đường nguội theo cosine hạng N; 1 = max (hành vi cũ)
SPV_MISMATCH_STREAK_MAX=2                  # van thoát: chỉ đếm final CÓ cụm nhất quán
                                            # (>= SPV_ENROLL_MIN_CLUSTER) mà không khớp asker;
                                            # final bằng-chứng-less (câu quá ngắn) không tính
SPV_UTT_CAP_SEC=30
# noble-speaker-service bind address (when running the resident embed service)
SPEAKER_SERVICE_HOST=0.0.0.0
SPEAKER_SERVICE_PORT=9100

# ── Observability: Arize Phoenix (self-hosted OTEL LLM tracing) ──────────────
# Auto-instruments the Anthropic + OpenAI SDKs (openai/dashscope/vllm/gemini
# slots) so every LLM turn emits spans to a self-hosted Phoenix collector.
# EMPTY PHOENIX_COLLECTOR_ENDPOINT is the gate → clean no-op (no import, no
# crash). Requires the optional `tracing` extra: pip install -e ".[tracing]".
# Endpoint auto-appends /v1/traces if missing. API key → Authorization: Bearer.
PHOENIX_COLLECTOR_ENDPOINT=
PHOENIX_API_KEY=
PHOENIX_PROJECT_NAME=noble-voice-agent

# ── Multi-tenant store (SaaS slice #1) ──────────────────────────────────────
# Master flag. false (default) = pure in-wheel tenants (offline, unchanged).
TENANT_STORE_ENABLED=false
# MinIO / S3-compatible object store holding tenant bundles.
MINIO_ENDPOINT=http://minio.example:9000
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=changeme
TENANT_BUCKET=hotline-tenants
# Local dir tenant bundles are synced into at boot.
TENANT_MATERIALIZE_DIR=/var/lib/noble/tenants
# SP-C2: TTL (seconds) for the published-version pointer read. A new conversation
# picks up a newly published version within ~this window. 0 = resolve at boot only.
NOBLE_CONFIG_POLL_SEC=20
# SP-D heartbeat (contract C3): agent writes <tenant>/_heartbeat.json to the tenant
# store every NOBLE_HEARTBEAT_SEC so Backend/Dashboard can infer status. Effective
# only when TENANT_STORE_ENABLED=true (else nothing to write → inert). aiortc only.
NOBLE_HEARTBEAT_ENABLED=true
NOBLE_HEARTBEAT_SEC=20

# ── SaaS slice #2: provider-facing gateway ─────────────────────────────────
# Ingress gateway routes provider clients (voice/chat) to the right worker per tenant.
# No tenant points at it by default → existing path unchanged (backward-compat).
# Console script: noble-gateway
TENANT_ENDPOINT_TEMPLATE=wss://{tenant_id}.agents.noblex.vn
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=9200
GATEWAY_CRED_CACHE_TTL_SEC=30
# Shared secret cho hop gateway→worker (X-Gateway-Secret). Rỗng ⇒ worker mở cho
# bất kỳ ai chạm được :8766 (dev/trust-network). Per-tenant PG credential
# forwarding (X-PG-Role/-Password/-Expires) CHỈ được worker ingest khi secret
# này được set — rỗng thì worker bỏ qua các header đó (không tin hop chưa xác thực).
GATEWAY_WORKER_SECRET=
# URL đầy đủ của Portal runtime-credentials API (POST, Bearer = API key của
# provider). Rỗng ⇒ gateway fail-closed: từ chối MỌI kết nối.
GATEWAY_CREDENTIALS_API_URL=
WORKER_CHAT_INTERNAL_URL_TEMPLATE=ws://agent:8766/chat
