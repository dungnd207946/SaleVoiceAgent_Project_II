# ─── Cổng dev ───────────────────────────────────────────────────────────────
# Bốn biến này docker-compose.dev.yml đọc; giá trị dưới đây trùng default trong
# compose nên khai lại là để bạn thấy được số thật mà không phải mở compose ra.
#
# Vì sao lệch khỏi cổng mặc định của từng dịch vụ: máy dev này còn chạy icr-infra
# (postgres 5433, redis 6380, keycloak 8080, minio 9100/9101), credit-scoring
# (8000, 5555, 3100) và santa (6379, 27017). Chi tiết: ../docs/dev-ports.md.
PORTAL_PG_PORT=5442
PORTAL_REDIS_PORT=6382
PORTAL_QDRANT_PORT=6343
PORTAL_QDRANT_GRPC_PORT=6344
PORTAL_MINIO_PORT=9002
PORTAL_MINIO_CONSOLE_PORT=9003

# Cổng uvicorn của Portal API (`make api`). 8080 KHÔNG dùng được — icr-keycloak
# đang giữ. `vite.config.ts` của repo frontend proxy '^/api/' tới đúng cổng này,
# nên đổi ở đây thì đổi cả bên đó.
PORTAL_API_PORT=8100

# API chạy TRONG container (profile `app` của docker-compose.local.yml). Khác
# PORTAL_API_PORT có chủ đích: hai đường phải chạy được đồng thời để so "trên host
# thì đúng, trong container thì sai".
PORTAL_API_DOCKER_PORT=8101

# Số job worker chạy đồng thời. Trần từng loại việc khai ở register(), không ở đây.
# Nhân số container worker sẽ NHÂN con số này lên.
WORKER_BUDGET=12

# ─── Postgres ───────────────────────────────────────────────────────────────
# HAI DSN, HAI ROLE. Đừng gộp lại thành một.
#
# Vì sao: `portal_migrator` là owner của mọi schema (và ở container dev nó là
# bootstrap superuser). Superuser/owner bỏ qua RLS BẤT KỂ `FORCE`, nên một tiến
# trình runtime nối bằng nó chạy hoàn toàn NGOÀI cách ly — một truy vấn quên
# WHERE đọc và ghi xuyên mọi tenant, âm thầm. Chi tiết: deploy/README.md §1–§2.

# DSN RUNTIME (asyncpg) — role portal_api. API và worker đọc đúng biến này.
# portal_api KHÔNG là owner, KHÔNG BYPASSRLS, KHÔNG superuser.
#
# Migration 0003 tạo portal_api ở dạng NOLOGIN KHÔNG MẬT KHẨU (fail-closed: không
# ship mật khẩu nào trong git). Nên ở máy dev, chạy MỘT LẦN sau `make migrate`:
#     ALTER ROLE portal_api LOGIN PASSWORD 'apidev';
# Production dùng mật khẩu thật, xem deploy/README.md §3.
# Credential của container Postgres dev — trước 2026-08-20 chúng nằm cứng trong
# docker-compose.local.yml. Compose đọc CHÍNH file .env này để thay ${...}, nên
# đây là nguồn sự thật duy nhất; các default `:-` còn trong compose chỉ là lưới
# cho máy chưa có .env.
#
# Đổi ở đây thì hai DSN dưới phải đổi theo — compose dựng server theo bốn biến
# này, app nối theo DSN, và lệch nhau là "password authentication failed".
PORTAL_PG_USER=portal_migrator
PORTAL_PG_PASSWORD=dev
PORTAL_PG_DB=portal

# `portal_api` do migration 0003 tạo ở dạng NOLOGIN không mật khẩu (fail-closed:
# không mật khẩu nào nằm trong git). `make grant-api-dev` đặt mật khẩu, và nó đọc
# đúng hai biến này.
PORTAL_API_DB_USER=portal_api
PORTAL_API_DB_PASSWORD=apidev

DATABASE_URL=postgresql://portal_api:apidev@localhost:5442/portal

# DSN CHỈ-DDL — role portal_migrator. CHỈ `alembic` dùng (Settings.alembic_url suy
# từ biến này rồi đổi driver sang psycopg). KHÔNG tiến trình runtime nào được dùng.
MIGRATOR_URL=postgresql://portal_migrator:dev@localhost:5442/portal

# ─── Aurora PostgreSQL (production) ─────────────────────────────────────────
# Hai DSN trên ở dev trỏ container localhost:5442. Ở production chúng trỏ Aurora:
#
#   DATABASE_URL=postgresql://portal_api:<bí mật>@<cluster>.cluster-xxxx.<region>.rds.amazonaws.com:5432/portal
#   MIGRATOR_URL=postgresql://portal_migrator:<bí mật>@<cluster>.cluster-xxxx.<region>.rds.amazonaws.com:5432/portal
#
# Dùng WRITER endpoint (`.cluster-`) cho cả hai. Reader endpoint
# (`.cluster-ro-`) KHÔNG dùng được: mọi truy vấn tenant_data nằm trong giao dịch
# có `SET LOCAL app.tenant_id`, và migration thì ghi. Nếu sau này thêm đường đọc
# thuần thì đó là một biến MỚI, không phải sửa hai biến này.
#
# Aurora không có superuser thật — master user chỉ là thành viên `rds_superuser`.
# Xem deploy/README.md §6: điều đó ĐỔI lý lẽ của §1, không xoá nó.

# ─── Kho tệp: S3 (production) · MinIO (dev) ─────────────────────────────────
# TÊN BIẾN THẬT LÀ S3_*, KHÔNG PHẢI AWS_* — `Settings` đọc S3_ENDPOINT_URL,
# S3_BUCKET, S3_ACCESS_KEY, S3_SECRET_KEY, S3_REGION (core/config.py). Bản trước
# của file này khai AWS_REGION/AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY từ thời M3
# còn là dự định; đặt đúng những tên đó thì không biến nào tới được app.
#
# Ở production để trống hai khoá là ĐÚNG, không phải thiếu cấu hình: credential
# lấy từ IAM role của task (chốt 2026-07-30), và S3_ENDPOINT_URL rỗng ⇒ endpoint
# AWS thật.
#   S3_ENDPOINT_URL=
#   S3_BUCKET=odyssey-portal-prod
#   S3_ACCESS_KEY=
#   S3_SECRET_KEY=
#   S3_REGION=ap-southeast-1

# Gốc URL công khai của ảnh agent gửi cho khách: biến PUBLIC_BASE_URL, khai MỘT LẦN
# ở khối «Gửi thư» phía dưới — từ 2026-08-17 nó mang CẢ link ảnh CẢ link mời trong
# thư (trước đó link mời có biến riêng PORTAL_BASE_URL, đã gộp). Địa chỉ nội bộ
# (localhost) ⇒ không sinh link ảnh, nhưng link mời vẫn dùng được — nên ở dev cứ đặt
# http://localhost:5273; muốn nạp ảnh cho agent ở dev thì trỏ vào một tunnel expose
# CẢ cổng 5273 (app FE) lẫn /api/, không chỉ cổng 8100.
#
# Dev — MinIO của docker-compose.local.yml. Endpoint tường minh là thứ DUY NHẤT
# khác production; client aioboto3 y hệt.
#
# ⚠️ S3_ACCESS_KEY/S3_SECRET_KEY có HAI người đọc: portal (để nối) và chính
# container MinIO (MINIO_ROOT_USER/MINIO_ROOT_PASSWORD trong compose). Đổi ở đây
# là đổi cả hai cùng lúc — đó là chủ đích; đặt lệch nhau là 403 lúc phát tệp.
S3_ENDPOINT_URL=http://localhost:9002
S3_BUCKET=odyssey
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# 307 tới URL có hạn của kho, thay vì tự tải byte về rồi gửi tiếp.
# ⚠️ MẶC ĐỊNH TẮT và bật là quyết định VẬN HÀNH: URL có hạn trỏ vào host của KHO,
# không phải host Portal. Kho không mở được từ Internet công cộng thì 307 làm ảnh
# vỡ phía khách mà không có lỗi nào phía ta. Bật SAU khi đã mở thử một URL công
# khai từ trình duyệt ngoài mạng nội bộ.
S3_REDIRECT_ENABLED=false
# Hạn của URL 307. Không lưu ở đâu cả — sinh mới mỗi lượt xem.
S3_REDIRECT_TTL_SEC=900

# ─── Redis ───────────────────────────────────────────────────────────────────
# Redis của docker-compose.local.yml chạy có `--requirepass`, nên DSN PHẢI mang mật
# khẩu — dạng `redis://:<mật-khẩu>@host:port/db` (user rỗng, dấu `:` đứng trước).
# Thiếu nó thì mọi lời gọi Redis trả `NOAUTH Authentication required`.
# Mật khẩu dev là `devredis`, khai trong compose. Production: mật khẩu thật, đặt
# REDIS_PASSWORD ở máy deploy — xem deploy/README.md.
# Compose đọc hai biến này để dựng container (`--requirepass`); app đọc REDIS_URL.
# Đổi mật khẩu thì đổi CẢ DSN dưới.
PORTAL_REDIS_PASSWORD=devredis
PORTAL_REDIS_DB=0
REDIS_URL=redis://:devredis@localhost:6382/0

# ─── Kho tri thức — một collection Qdrant mỗi workspace (M6) ─────────────────
# Cổng 6343, KHÔNG phải 6333 mặc định (docs/dev-ports.md).
QDRANT_URL=http://localhost:6343

# HAI VAI, một chuỗi — phải TRÙNG `service.api_key` của chính Qdrant:
#   1. khoá portal dùng để GHI (quyền đầy đủ)
#   2. khoá KÝ token chỉ-đọc phát cho pod agent qua /runtime-credentials
# Qdrant verify JWT bằng đúng `service.api_key`, không có khoá ký thứ hai.
#
# RỖNG = chưa bật xác thực Qdrant ⇒ /runtime-credentials trả `kb.api_key: null`,
# pod nối không kèm khoá, và MỌI pod đọc được collection của MỌI tenant. Đó là
# hiện trạng, không phải trạng thái đích.
#
# ⚠️ Đặt biến này KHÔNG tự bật cưỡng chế — Qdrant còn phải nhận cùng chuỗi đó.
# Thứ tự ba bước để bật mà không gián đoạn: docs/contracts/dau-noi-agent.md
# §"Bật xác thực Qdrant". Đảo thứ tự = agent 403 tới một giờ.
QDRANT_API_KEY=

# ─── Cổng nạp dữ liệu ngoài ──────────────────────────────────────────────────
# Bao nhiêu ngày không nhận được bản kê đối soát thì coi tenant là «im lặng» và
# ghi một dòng cảnh báo vào Nhật ký. 3 = chịu được hai lần lỡ của job chạy hằng
# đêm. Cron phải gọi: python -m portal.cli.kiem_tenant_im_lang
INGEST_IM_LANG_NGAY=3

# Giới hạn tốc độ THEO TOKEN. Hai cửa hai nhịp vì `/manifest` là phép so trên
# toàn bộ dữ liệu còn nhịp hợp lệ của nó chỉ là hằng đêm. Đếm REQUEST chứ không
# đếm bản ghi — TRAN_LO (500) đã chặn khối lượng mỗi lượt.
INGEST_NHIP_EVENTS_MOI_PHUT=120
INGEST_NHIP_MANIFEST_MOI_GIO=30

# Dọn `ingest_errors` — bảng chỉ lớn lên nếu không ai cắt. HAI vế: quá số ngày,
# VÀ quá số dòng mỗi tenant (vế sau chặn một đợt bùng, thứ mà cắt theo tuổi không
# đụng tới vì chúng đều mới tinh). Cron phải gọi: python -m portal.cli.don_loi_nap
INGEST_LOI_GIU_NGAY=30
INGEST_LOI_TRAN_HANG=2000

# ─── Mã hoá at-rest cho hai cột khoá THÔ ─────────────────────────────────────
# Phủ CẢ `control.agent_keys.api_key` LẪN `control.ingest_tokens.token`. Cả hai
# lưu chuỗi đọc lại được có chủ đích (giao diện bày ra), nên không thể chỉ lưu băm.
#
# KHOÁ RIÊNG, KHÔNG dẫn xuất từ AGENT_MASTER_KEY — quyết định về VÒNG ĐỜI: xoay
# khoá gốc là mọi tenant suy lại mật khẩu Postgres/S3; nếu nó còn giải mã token thì
# một lần xoay mà quên mã hoá lại là MẤT VĨNH VIỄN mọi khoá thô.
#
# Rỗng ở development ⇒ dẫn xuất từ khoá gốc dev. Rỗng ở production ⇒ NÉM.
#   python -c 'import secrets;print(secrets.token_urlsafe(32))'
TOKEN_ENC_KEY=

# ─── Đấu nối agent ngoài (M10) ───────────────────────────────────────────────
# Ở dev cả ba để trống là chạy được: ENVIRONMENT=development nên khoá gốc dùng
# giá trị dev cố định trong code. Ở production PHẢI đặt, và app TỪ CHỐI KHỞI ĐỘNG
# nếu chúng yếu — không phải cảnh báo, là dừng hẳn.

ENVIRONMENT=development

# AGENT_MASTER_KEY — BÍ MẬT HẠNG CAO NHẤT TRONG HỆ. Mọi mật khẩu Postgres và
# secret key S3 của MỌI tenant được suy dẫn từ nó (modules/enrollment/bi_mat.py);
# rò nó là rò tất cả. Portal KHÔNG lưu mật khẩu nào, chỉ lưu một số thế hệ.
# Đổi nó = mọi tenant phải xoay bí mật.
#   python -c 'import secrets;print(secrets.token_urlsafe(32))'
AGENT_MASTER_KEY=

# PLATFORM_ADMIN_TOKEN — mở 5 route /api/v1/agent/admin/* (cấp phát · thu hồi ·
# xoay khoá). TẠM THỜI tới khi M2b có vai trò quản trị nền tảng thật; hệ quả đã
# biết là audit_log ghi actor="platform_admin", không ghi tên người.
PLATFORM_ADMIN_TOKEN=

# TTL credential /runtime-credentials trả về. Pod tự làm mới khi còn 1/4.
RUNTIME_CREDENTIALS_TTL_SECONDS=3600

# Tên miền gốc của gateway agent: ENDPOINT_URL của MỌI tenant suy từ nó —
# `wss://<tenant_id>.<đây>/v1/chat`. KHÔNG phải bí mật (hostname công khai).
# Đổi nó là đổi endpoint của TẤT CẢ tenant cùng lúc; khoá đã bàn giao vẫn dùng
# được, nhưng URL đã gửi cho đối tác thì hết trỏ đúng.
# Không có dấu `.` đầu, không có `/` cuối.
GATEWAY_BASE_DOMAIN=agents-dev.noble.vn

# ─── Hai khối endpoint đang TẮT (spec bo-organization §6.2) ──────────────────
# Không bị xoá — bảng, code và test giữ nguyên để bật lại khi có mô hình
# admin/quyền động. Mở ROLES_CRUD_ENABLED bây giờ nghĩa là Quản trị của MỘT
# workspace sửa/xoá được vai trò của MỌI workspace (vai trò đã toàn cục từ 0105).
ROLES_CRUD_ENABLED=false
USERS_ADMIN_ENABLED=false

# ─── Cookie phiên ────────────────────────────────────────────────────────────
# ĐỂ NGUYÊN (mặc định true). Bỏ comment dòng dưới CHỈ khi cần mở portal từ máy
# khác trong LAN qua http://<IP>:5273 ở dev: trình duyệt miễn trừ Secure-trên-http
# cho `localhost` chứ không cho IP, nên để true thì login trả 200 mà cookie không
# được lưu — mọi màn bật về /login, không báo lỗi gì.
#
# ĐỪNG đặt false ở production: cookie phiên đi qua đường không mã hoá, và cũng
# không có triệu chứng nào — mọi thứ chạy bình thường, chỉ là nghe lén được.
COOKIE_SECURE=true

# ─── Kho tri thức (module kb) ───────────────────────────────────────────────
# Thiếu thì worker vẫn chạy nhưng mọi job nạp/tạo mô tả failed.
# KB_EMBED_URL là gốc, KHÔNG kèm /embed (client tự nối PATH_EMBED).
# Dev cục bộ: SSH tunnel tới máy GPU (ssh -N -L 8013:127.0.0.1:8013 odyssey-dev).
# Cùng odyssey-network thì dùng tên service: http://embed:8013
KB_EMBED_URL=http://127.0.0.1:8013
KB_SANTA_MODELS_TOKEN=
KB_VLM_API_KEY=
KB_VLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
KB_GEMINI_API_KEY=

# ─── kb/web (thu thập dữ liệu công khai) ─────────────────────────────────────
# LLM tag/dossier/card/digest là qwen3.7-flash qua DashScope (KB_VLM_API_KEY); tra Google
# là gemini-2.5-flash (KB_GEMINI_API_KEY) — dùng chung key ở trên.
KB_WEB_LLM_CONCURRENCY=4
KB_WEB_GROUNDING_DAILY_CAP=1200
KB_WEB_FETCH_PER_DOMAIN=2
KB_WEB_FETCH_DELAY_SEC=1.0
KB_WEB_BROWSER_ENABLED=true
# Lượt sâu xếp 1/N số dự án mỗi ngày (mặc định 2 = một nửa; 1 = mọi dự án mỗi ngày)
KB_WEB_DEEP_SLICES=2

# ─── Gửi mail — đăng ký tự phục vụ (spec dang-ky-tu-phuc-vu §5.2) ────────────
SMTP_HOST=smtp.your-ses-region.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMTP_FROM phải là identity đã verify ở SES, vd no-reply@noblex.vn.
SMTP_FROM=
SMTP_FROM_NAME=NobleX
# ⚠ TÊN NÀY CỐ Ý KHÁC `SMTP_SECURE` của Nodemailer: true = STARTTLS (cổng 587,
# mở plaintext rồi nâng cấp TLS TRƯỚC khi gửi credential) — KHÔNG phải TLS ngầm.
SMTP_STARTTLS=true
PUBLIC_BASE_URL=https://odyssey-dev.noble.vn

# Công tắc POST /auth/register. Mặc định BẬT — tắt được không cần deploy khi có
# sự cố (không phải một tầng an toàn). Ở production, bật cờ này mà thiếu cấu
# hình SMTP phía trên làm app từ chối khởi động, xem ghi chú ở trên.
SIGNUP_ENABLED=true

GOOGLE_CLIENT_ID=<client id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<client secret>

# ── Người dẫn tự tạo (modules/nhan_vat) ─────────────────────────────────────
# API quản lý nhân vật của service lipsync-musetalk (odyssey-models, cổng 8021) +
# token chung ODYSSEY_MODELS_TOKEN của odyssey-models (rỗng = service tắt auth, chỉ dev).
NHAN_VAT_LIPSYNC_URL=http://lipsync-musetalk:8021
NHAN_VAT_MODELS_TOKEN=
# Nhà cung cấp SINH VIDEO TỪ ẢNH: rỗng = tắt «tạo từ ảnh» (chỉ còn upload video) · wan (khối dưới).
# Code còn hỗ trợ kling · fal · gia (giả lập) — tên biến + mặc định: src/portal/modules/nhan_vat/settings.py.
# Đổi nhà cung cấp = đổi env + restart worker.
NHAN_VAT_VIDEO_PROVIDER=
# Tạo-từ-ảnh luôn chỉnh dáng người trong ảnh về dáng người dẫn chuẩn. Clip đưa tay sinh SAU lần
# dựng đầu, từ khung chờ lipsync đã chọn (khung đầu = khung cuối), rồi dựng lại. false = bỏ đưa tay.
NHAN_VAT_TAO_CLIP_TAY=true
NHAN_VAT_THOI_LUONG_S=5
# clip đưa tay: giữ 5 (lipsync cắt ở 5s — dài hơn là mất đoạn hạ tay). Clip nói: lipsync dùng tối đa 8s.
NHAN_VAT_THOI_LUONG_TAY_S=5
# Wan (Alibaba Model Studio / DashScope). Khoá đọc NHAN_VAT_WAN_API_KEY hoặc MODEL_STUDIO_API_KEY;
# base dán nguyên «…/compatible-mode/v1» cũng được (chỉ lấy origin). Khoá + base + model CÙNG VÙNG.
# Model: wan2.7-* (đầu+cuối = ảnh gốc) · wan2.6-i2v-flash / wan2.5-i2v-preview / wan2.2-i2v-flash (chỉ frame đầu).
NHAN_VAT_WAN_API_KEY=
NHAN_VAT_WAN_BASE_URL=https://dashscope-intl.aliyuncs.com
NHAN_VAT_WAN_MODEL=wan2.7-i2v-2026-04-25
NHAN_VAT_WAN_RESOLUTION=720P
NHAN_VAT_WAN_TAIL=true
