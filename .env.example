# odyssey-models — copy sang .env (gitignored) và điền.
# Giá trị bị cắt ở " #": compose không tự cắt inline comment.

ODYSSEY_MODELS_TOKEN=
HF_TOKEN=  # BẮT BUỘC: santa-tts-omnivoice (:8016) là repo HF private
ODYSSEY_LOG_LEVEL=INFO

# tts-omnivoice :8016 — fine-tune giọng santa của mình. Đổi sang
# thanhhai03/OmniVoice-Luna-vi để quay lại giọng Luna gốc; cả hai cùng base
# k2-fsa/OmniVoice nên đều CC-BY-NC-4.0 (xem tts_omnivoice/README.md).
OMNIVOICE_MODEL_REPO=NobleX-AI/santa-tts-omnivoice

# stt :8012 — hotword biasing (bỏ trống STT_HOTWORDS_FILE = tắt)
STT_HOTWORDS_FILE=/app/hotwords.txt  # danh sách nền trong image; bind-mount file khác nếu muốn sửa nóng
STT_DECODING_METHOD=modified_beam_search  # bắt buộc cho hotwords (greedy_search = tắt)
STT_HOTWORDS_SCORE=1.5  # boost mặc định cho phrase không có hậu tố :score

# embed :8013 — tên theo vai trò, đổi model không phải đổi tên biến
EMBED_DENSE_MODEL=intfloat/multilingual-e5-large  # nhánh text (E5-large 1024d)
EMBED_SPARSE_MODEL=Qdrant/bm25
EMBED_VISUAL_MODEL=google/siglip2-base-patch16-256  # nhánh visual (SigLIP2 768d)
EMBED_VISUAL_MAXLEN=64
EMBED_DEVICE=cpu
EMBED_BATCH_SIZE=32
EMBED_WARMUP=dense,sparse,visual_image,visual_text  # nạp sẵn cả 4, đừng để agent chờ

# lipsync-musetalk :8020 — UNet mặc định là bản fine-tune tiếng Việt NobleX-AI/santa-lipsync-musetalk
# (PRIVATE ⇒ cần HF_TOKEN ở trên); các weights còn lại ở repo công khai. Xem lipsync_musetalk/README.md
LIPSYNC_BATCH_SIZE=8  # 16 hết VRAM khi chung card với TTS
LIPSYNC_MAX_SESSIONS=1  # phiên lip sync cùng lúc — đo bằng lipsync_musetalk/do_tai.py trước khi nâng
LIPSYNC_FACEPARSE_REPO=ManyOtherFunctions/face-parse-bisent  # mirror face-parse — đổi được, SHA-256 vẫn phải khớp
# Đổi UNet (rỗng = fine-tune tiếng Việt). Về MuseTalk V1.5 gốc: TMElyralab/MuseTalk · musetalkV15/unet.pth ·
# 7ebf6c98c181e20838e4c0054e96e944ac60d5d692cc01db42839fe11b787007 (đặt đủ cả ba).
LIPSYNC_UNET_REPO=
LIPSYNC_UNET_FILE=
LIPSYNC_UNET_SHA256=
