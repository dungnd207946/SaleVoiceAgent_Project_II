# ═══════════════════════════════════════════════════════════════════════════
# Noble Voice Agent — RunPod .env template
#
# Cách dùng:
#   1) cp infra/runpod/env.runpod.example .env
#   2) Edit (nano .env) — chỉnh HF_TOKEN và bất kỳ key nào cần đổi
#   3) bash infra/runpod/setup.sh
#
# setup.sh đọc .env tự động (set -a; source .env) → KHÔNG cần inline
# `HF_TOKEN=... NOBLE_DATA_HF_REPO=... bash setup.sh`.
# ═══════════════════════════════════════════════════════════════════════════

# ── HuggingFace (REQUIRED — kéo data + Qwen3.6 model) ───────────────────────
HF_TOKEN=
NOBLE_DATA_HF_REPO=NMCxyz/flat_store
HF_MODEL_REPO=Qwen/Qwen3.6-35B-A3B

# ── LLM: self-hosted vLLM local (setup.sh stage env tự wire) ────────────────
OPENAI_BASE_URL=http://localhost:8000/v1
OPENAI_MODEL=Qwen/Qwen3.6-35B-A3B
OPENAI_API_KEY=__REPLACE_ME__
OPENAI_REASONING_EFFORT=none

# ── ToolHint embeddings (vLLM không có /v1/embeddings) ──────────────────────
# Để trống = ToolHint disabled (acceptable). Nếu muốn bật → set OpenAI key thật:
OPENAI_EMBEDDING_BASE_URL=https://api.openai.com/v1
# OPENAI_EMBEDDING_API_KEY=sk-...

# ── LLM fallback chain (giữ nguyên key cloud làm backup) ────────────────────
GEMINI_API_KEY=__REPLACE_ME__
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

DASHSCOPE_API_KEY=__REPLACE_ME__
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.5-flash

# ── Transport: LiveKit Cloud ────────────────────────────────────────────────
TRANSPORT_BACKEND=livekit
LIVEKIT_URL=wss://santahotlin-d1hph5oo.livekit.cloud
LIVEKIT_API_KEY=__REPLACE_ME__
LIVEKIT_API_SECRET=__REPLACE_ME__
LIVEKIT_AGENT_NAME=
WORKER_MAX_CONCURRENT_SESSIONS=50

# ── Storage (EC2 self-hosted ap-southeast-1) ────────────────────────────────
# MongoDB: dedicated `hotline_agent` DB with auth user `hotline_user`.
# Schema (10 collections + indexes) initialized via `scripts/mongo_migrate_*.py`.
MONGODB_URI=mongodb://hotline_user:<MONGO_PASSWORD>@ec2-47-129-187-61.ap-southeast-1.compute.amazonaws.com:27017/hotline_agent?authSource=hotline_agent
MONGODB_DATABASE=hotline_agent

# Redis: shared with chat-agent on same EC2. DB 0 = hotline, DB 1 = chat-agent.
REDIS_URL=redis://:<REDIS_PASSWORD>@ec2-47-129-187-61.ap-southeast-1.compute.amazonaws.com:6379/0

# Qdrant: shared cluster (hotline-agent uses flat_store, Qdrant only as fallback)
QDRANT_URL=http://ec2-47-129-187-61.ap-southeast-1.compute.amazonaws.com:6333
QDRANT_API_KEY=<QDRANT_API_KEY>
QDRANT_COLLECTION=lightrag_vdb_entities_baai_bge_m3_1024d

# ── STT ─────────────────────────────────────────────────────────────────────
STT_BACKEND=soniox
SONIOX_API_KEY=__REPLACE_ME__

# Qwen3-ASR (DashScope) fallback
QWEN3ASR_MODE=dashscope
QWEN3ASR_API_KEY=__REPLACE_ME__
QWEN3ASR_REGION=intl

# ── TTS ─────────────────────────────────────────────────────────────────────
TTS_BACKEND=elevenlabs
ELEVENLABS_API_KEY=__REPLACE_ME__
ELEVENLABS_TTS_VOICE_ID=iSFxP4Z6YNcx9OXl62Ic
ELEVENLABS_TTS_MODEL=eleven_turbo_v2_5
ELEVENLABS_TTS_LANGUAGE_CODE=vi
ELEVENLABS_TTS_STABILITY=1.0
ELEVENLABS_TTS_SIMILARITY_BOOST=0.75
ELEVENLABS_TTS_SPEED=1.13

# ── RAG ─────────────────────────────────────────────────────────────────────
NOBLE_RAG_BACKEND=flat_store
FLAT_STORE_SKIP_FAQ=true
FAQ_SEMANTIC_INJECT_ENABLED=true
FAQ_SEMANTIC_TOP_K=5
FLAT_STORE_MODEL=intfloat/multilingual-e5-large
FLAT_STORE_CACHE_DIR=data/flat_store
# Pod paths (setup.sh stage env tự override SANTA_CHAT_DATA_DIR theo REPO_ROOT)
SANTA_CHAT_DATA_DIR=/workspace/santa-hotline-agent/data/rag
FASTEMBED_CACHE_PATH=/root/.cache/fastembed

# ── Business ────────────────────────────────────────────────────────────────
NOBLE_HOTLINE=18006298
NOBLE_WORKING_HOURS=8:00-21:00

# ── Email (escalation) ──────────────────────────────────────────────────────
EMAIL_ENABLED=true
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USER=cuong220103@gmail.com
EMAIL_APP_PASSWORD=__REPLACE_ME__
EMAIL_DEFAULT_FROM=luna@noblex.vn

# ── Postgres mock (giữ nguyên cho tests) ────────────────────────────────────
DATA_MODE=mock
POSTGRES_URI_MOCK=postgresql://cuongnm1:password@localhost:5432/noble_db

# ── Server (LiveKit worker — RunPod nginx blocks 8081 → use 8082) ───────────
LIVEKIT_WORKER_PORT=8082
WS_HOST=0.0.0.0
WS_PORT=8766

# CRM + telephony — pod = LiveKit-only mode
CRM_MODE=mock
RAG_COSINE_THRESHOLD=0.5
TELEPHONY_ENABLED=false
