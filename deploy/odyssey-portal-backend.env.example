# Vai `serve`. Chép thành `odyssey-portal-backend.env` (đã gitignore), điền, không commit.
# ⚠ CỐ TÌNH không có MIGRATOR_URL — entrypoint từ chối khởi động nếu thấy nó (README §1-§2).

# Role `portal_api`: không phải chủ sở hữu bảng, không BYPASSRLS, không superuser —
# đó là điều làm cách ly giữa các tenant có hiệu lực. Aurora: WRITER endpoint.
# Mật khẩu do devops đặt tay một lần (README §3), migration không đặt.
DATABASE_URL=postgresql://portal_api:<mật-khẩu>@<cluster>.cluster-xxxx.ap-southeast-1.rds.amazonaws.com:5432/portal

# Container trong docker-compose.dev.yml; cổng là cổng bên trong container.
# HAI biến, MỘT mật khẩu — service `redis` đọc REDIS_PASSWORD từ chính file này,
# backend đọc REDIS_URL. Lệch nhau thì lỗi là `WRONGPASS`; thiếu trong REDIS_URL thì
# `NOAUTH Authentication required`; thiếu REDIS_PASSWORD thì container redis chết ngay.
# Trong DSN: user rỗng, dấu `:` đứng trước mật khẩu, và ký tự đặc biệt (`@ : / ?`)
# phải percent-encode — không thì DSN bị parse sai host.
REDIS_PASSWORD=<mật-khẩu-redis>
REDIS_URL=redis://:<mật-khẩu-redis>@redis:6379/0
QDRANT_URL=http://qdrant:6333

# Để trống là 8100 — khớp EXPOSE của Dockerfile, healthcheck, và default của
# ODYSSEY_PORTAL_API_UPSTREAM ở repo frontend. Đổi thì đổi cả ba chỗ.
# PORTAL_API_PORT=8100

# Cách ly tenant ở tầng kho tệp là TIỀN TỐ `tenants/<id>/`, không phải bucket riêng
# — nên mọi route đọc tệp phải tự kiểm tiền tố của principal (core/storage.py).
# S3_ENDPOINT_URL: để trống khi dùng Amazon S3 thật, điền khi dùng MinIO.
S3_ENDPOINT_URL=
S3_BUCKET=odyssey
S3_REGION=ap-southeast-1

# Domain khách mở được (không phải tên container). Đổi giá trị = chạy lại
# scripts/backfill_public_url.py, vì URL cũ đã nằm trong tenant_data.media.
#
# ⚠ Từ 2026-08-17 biến này CŨNG là gốc link đặt mật khẩu trong thư mời/đăng ký
# (mailer.url_tuyet_doi → {base}/invite/<token>, một route của app FE). Nên nó phải
# là origin phục vụ CẢ app FE CẢ /api/, và RỖNG ở đây nghĩa là mailer TẮT — với
# SIGNUP_ENABLED=true ở production thì app TỪ CHỐI KHỞI ĐỘNG. Trước khi gộp, link
# mời đọc một biến PORTAL_BASE_URL riêng mà tệp này chưa bao giờ khai: production
# đã chạy với mailer tắt, không dấu hiệu nào.
PUBLIC_BASE_URL=https://odyssey-dev.noble.vn

# Amazon S3: ĐỂ TRỐNG cả hai — credential đọc/ghi object lấy từ IAM role (README §7.2).
# MinIO: muốn cấp kho tệp per-tenant thì phải điền credential có quyền ADMIN API
# (admin:*): luồng phát khoá agent (M10) gọi `user_add`/`policy_add` — admin API
# không có đường IAM, và access key thường bị từ chối. Nên là một user MinIO riêng
# gắn policy admin, không phải cặp MINIO_ROOT_*.
#
# ĐỂ TRỐNG thì khoá agent VẪN PHÁT ĐƯỢC (khoá không cần kho tệp) — chỉ bước cấp
# access key kho tệp cho tenant bị bỏ qua, ghi `kho_tep: false` vào audit log.
# Pod dùng bộ S3 trong bootstrap sẽ bị từ chối cho tới khi điền hai dòng này và
# phát lại khoá / xoay bí mật. Trước 2026-08-05 để trống là POST /agent/keys 500
# ("Access key must not be empty") — đã đổi thành bỏ-qua-có-ghi-vết.
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Đấu nối agent (M10) ────────────────────────────────────────────────────────
# ENVIRONMENT=production bật chế độ từ chối bí mật yếu. KHÔNG set thì app chạy chế
# độ development và AGENT_MASTER_KEY rỗng sẽ RƠI VỀ KHOÁ DEV HARDCODE TRONG SOURCE
# — trên môi trường thật đó là suy được credential của mọi tenant từ code công khai.
ENVIRONMENT=production

# Khoá gốc suy dẫn MỌI credential agent (bi_mat.py) — bí mật hạng cao nhất trong hệ.
# Đổi nó = mọi tenant phải xoay bí mật. Tối thiểu 32 byte.
# Sinh: python -c 'import secrets;print(secrets.token_urlsafe(32))'
AGENT_MASTER_KEY=

# Tên miền gốc gateway — ENDPOINT_URL của mọi tenant suy từ nó (wss://<tenant>.<đây>/v1/chat).
# Có default trong code; chỉ set khi khác agents.noblex.vn.
# GATEWAY_BASE_DOMAIN=agents.noblex.vn

# ── Kho tri thức (module kb) ──────────────────────────────────────────────────
# Thiếu bốn biến này thì worker VẪN LÊN XANH (không healthcheck) nhưng mọi job
# kb_index/kb_enrich failed — dấu hiệu duy nhất là badge "N mục lỗi" trên màn.
# KB_EMBED_URL là gốc, KHÔNG kèm /embed (client tự nối PATH_EMBED).
KB_EMBED_URL=http://embed:8013
KB_SANTA_MODELS_TOKEN=
KB_VLM_API_KEY=
KB_GEMINI_API_KEY=

# ── Cửa Google (OAuth) ────────────────────────────────────────────────────────
# Cửa Google — RỖNG ⇒ tắt. Lấy ở Google Cloud Console → Credentials →
# OAuth client ID → Web application. Authorized redirect URI phải khớp CHÍNH XÁC
# <PUBLIC_BASE_URL>/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ══ Bổ sung 2026-08-20 — 17 biến `Settings` ĐỌC mà file này chưa từng khai ═════
# Cùng lớp lỗi với PORTAL_BASE_URL (xem CLAUDE.md 2026-08-17): một biến app đọc
# mà template deploy không khai thì production chạy bằng default trong code, và
# mọi chế độ hỏng ở đây đều IM LẶNG. Để trống là đồng ý với default — cứ để
# trống, nhưng phải THẤY nó.
#
# ⚠️ KHÔNG thêm MIGRATOR_URL vào file này: entrypoint TỪ CHỐI vai `serve` nếu
# thấy nó (deploy/README.md §1–§2). DSN đó ở odyssey-portal-migrate.env.

# ── Gửi thư — BẮT BUỘC nếu SIGNUP_ENABLED (mặc định true) ─────────────────────
# Thiếu SMTP_HOST/SMTP_FROM/PUBLIC_BASE_URL ở production ⇒ POST /auth/register
# NÉM (kiem_tra_dang_ky_mau_thuan_san_xuat). Ở dev thì mailer chỉ in thư ra
# stdout, nên khoảng hở này chỉ lộ ra ở production.
# ⚠️ SMTP_STARTTLS ≠ SMTP_SECURE của Nodemailer: cổng 587 là STARTTLS (=true ở
# đây); map `SMTP_SECURE=false` thành false là đẩy user/pass SES đi plaintext.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=NobleX
SMTP_STARTTLS=true

# Công tắc POST /auth/register. Mặc định BẬT — không phải tầng an toàn, chỉ là
# khả năng tắt đăng ký khi có sự cố mà không cần deploy.
SIGNUP_ENABLED=true

# ── Mã hoá at-rest cho hai cột khoá THÔ ───────────────────────────────────────
# RỖNG Ở PRODUCTION ⇒ NÉM (không im lặng ghi plaintext). Khoá RIÊNG, KHÔNG dẫn
# xuất từ AGENT_MASTER_KEY — xoay khoá gốc mà nó còn giải mã token thì một lần
# quên mã hoá lại là mất vĩnh viễn mọi khoá thô.
# Sinh: python -c 'import secrets;print(secrets.token_urlsafe(32))'
TOKEN_ENC_KEY=

# ── Quản trị nền tảng ─────────────────────────────────────────────────────────
# Mở /api/v1/agent/admin/* (cấp phát · thu hồi · xoay khoá). RỖNG = đóng.
PLATFORM_ADMIN_TOKEN=

# TTL credential /runtime-credentials trả về. Pod tự làm mới trước khi hết.
RUNTIME_CREDENTIALS_TTL_SECONDS=3600

# ── Qdrant ────────────────────────────────────────────────────────────────────
# HAI VAI, một chuỗi: khoá portal GHI + khoá KÝ token chỉ-đọc phát cho pod.
# Phải TRÙNG `service.api_key` của Qdrant. RỖNG = chưa bật xác thực ⇒ MỌI pod
# đọc được collection của MỌI tenant. Bật là ba bước CÓ THỨ TỰ:
# docs/contracts/dau-noi-agent.md §"Bật xác thực Qdrant" — đảo thứ tự = agent 403.
QDRANT_API_KEY=

# ── Kho tệp: 307 tới URL có hạn ───────────────────────────────────────────────
# Bật SAU khi đã mở thử một URL công khai từ trình duyệt NGOÀI mạng nội bộ: URL
# có hạn trỏ vào host của KHO, và kho không mở được từ Internet thì ảnh vỡ phía
# khách mà không có lỗi nào phía ta (repo này đã vấp đúng chỗ đó hai lần).
S3_REDIRECT_ENABLED=false
S3_REDIRECT_TTL_SEC=900

# ── Cookie phiên ──────────────────────────────────────────────────────────────
# ĐỪNG đặt false ở production: cookie phiên đi qua đường không mã hoá và KHÔNG
# có triệu chứng nào — mọi thứ chạy bình thường, chỉ là nghe lén được.
COOKIE_SECURE=true

# ── Kho tri thức: hai biến còn lại của module kb ───────────────────────────────
# KB_VLM_BASE_URL chỉ đổi khi dùng nhà cung cấp khác. Kho tệp của kb là S3_* ở trên.
KB_VLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# ── Cổng nạp dữ liệu ngoài ────────────────────────────────────────────────────
# Cả năm có default hợp lý trong code; khai ở đây để một môi trường muốn siết
# nhịp không phải deploy lại. INGEST_LOI_* cần cron gọi
# `python -m portal.cli.don_loi_nap`; INGEST_IM_LANG_NGAY cần
# `python -m portal.cli.kiem_tenant_im_lang`.
INGEST_NHIP_EVENTS_MOI_PHUT=120
INGEST_NHIP_MANIFEST_MOI_GIO=30
INGEST_LOI_GIU_NGAY=30
INGEST_LOI_TRAN_HANG=2000
INGEST_IM_LANG_NGAY=3

# ── Hai khối endpoint đang TẮT (spec bo-organization §6.2) ─────────────────────
# Mở ROLES_CRUD_ENABLED nghĩa là Quản trị của MỘT workspace sửa/xoá được vai trò
# của MỌI workspace (vai trò toàn cục từ 0105). Để false.
ROLES_CRUD_ENABLED=false
USERS_ADMIN_ENABLED=false

# Số job worker chạy đồng thời. Trần từng loại việc khai ở register(), không ở đây.
# Nhân số container worker sẽ NHÂN con số này lên.
WORKER_BUDGET=12

# ── Người dẫn tự tạo (modules/nhan_vat) ─────────────────────────────────────
# API quản lý nhân vật của service lipsync-musetalk (odyssey-models, cổng 8021) +
# token chung ODYSSEY_MODELS_TOKEN của odyssey-models (rỗng = service tắt auth, chỉ dev).
NHAN_VAT_LIPSYNC_URL=http://lipsync-musetalk:8021
NHAN_VAT_MODELS_TOKEN=
# Nhà cung cấp SINH VIDEO TỪ ẢNH: rỗng = tắt «tạo từ ảnh» (chỉ còn upload video) · wan (khối dưới).
# Code còn hỗ trợ kling · fal · gia (giả lập) — tên biến + mặc định: src/portal/modules/nhan_vat/settings.py.
# Đổi nhà cung cấp = đổi env + restart worker.
NHAN_VAT_VIDEO_PROVIDER=
# Tạo-từ-ảnh luôn chỉnh dáng người trong ảnh về dáng người dẫn chuẩn. Clip đưa tay sinh SAU lần
# dựng đầu, từ khung chờ lipsync đã chọn (khung đầu = khung cuối), rồi dựng lại. false = bỏ đưa tay.
NHAN_VAT_TAO_CLIP_TAY=true
NHAN_VAT_THOI_LUONG_S=5
# clip đưa tay: giữ 5 (lipsync cắt ở 5s — dài hơn là mất đoạn hạ tay). Clip nói: lipsync dùng tối đa 8s.
NHAN_VAT_THOI_LUONG_TAY_S=5
# Wan (Alibaba Model Studio / DashScope). Khoá đọc NHAN_VAT_WAN_API_KEY hoặc MODEL_STUDIO_API_KEY;
# base dán nguyên «…/compatible-mode/v1» cũng được (chỉ lấy origin). Khoá + base + model CÙNG VÙNG.
# Model: wan2.7-* (đầu+cuối = ảnh gốc) · wan2.6-i2v-flash / wan2.5-i2v-preview / wan2.2-i2v-flash (chỉ frame đầu).
NHAN_VAT_WAN_API_KEY=
NHAN_VAT_WAN_BASE_URL=https://dashscope-intl.aliyuncs.com
NHAN_VAT_WAN_MODEL=wan2.7-i2v-2026-04-25
NHAN_VAT_WAN_RESOLUTION=720P
NHAN_VAT_WAN_TAIL=true

# ── kb/web — crawl-worker (màn «Dữ liệu ngoài», 2026-10-05) ───────────────────
# Cùng file env với backend/worker trên on-prem (docker-compose.onprem.yaml). Dùng chung
# KB_VLM_API_KEY (DashScope) và KB_GEMINI_API_KEY (tra Google) ở trên; trần tra Google theo tenant
# ở tenant_data.kbweb_limits + lưới toàn hệ KB_WEB_GROUNDING_DAILY_CAP. Thiếu KB_VLM_API_KEY
# thì crawl-worker thoát ngay lúc khởi động — các vai khác không đụng.
KB_WEB_GROUNDING_DAILY_CAP=1200
KB_WEB_BROWSER_ENABLED=true
