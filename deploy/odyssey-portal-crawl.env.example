# Vai `crawl` và `crawl-worker` — kb/web (thu thập dữ liệu công khai).
# Chép thành `odyssey-portal-crawl.env` (đã gitignore), điền, không commit.
# ⚠ CỐ TÌNH không có MIGRATOR_URL — entrypoint từ chối khởi động nếu thấy nó
#   (README §1-§2). Cả hai vai chạy bằng role runtime `portal_api`.

# Role `portal_api`, DSN giống hệt vai `serve`/`worker` — có thể trỏ chung file
# odyssey-portal-backend.env nếu muốn, tách ra đây để đổi credential crawl không
# đụng backend.
DATABASE_URL=postgresql://portal_api:<mật-khẩu>@<cluster>.cluster-xxxx.ap-southeast-1.rds.amazonaws.com:5432/portal

# BẮT BUỘC đặt ở deploy. Bộ đếm trần Gemini/ngày (`GroundingBudget`) sống ở Redis,
# khoá theo NGÀY GIỜ VN nên tự về 0 mỗi ngày và dùng chung giữa `crawl-worker` với
# các lượt `crawl`. Thiếu biến này thì code rơi về mặc định `redis://localhost:6382/0`
# (Redis của máy dev) — trong container không có gì ở đó, lượt grounding đầu tiên
# lỗi kết nối và job hồ sơ hỏng.
REDIS_URL=redis://:<mật-khẩu-redis>@redis:6379/0

QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# KB_EMBED_URL là gốc, KHÔNG kèm /embed (client tự nối path) — cùng biến với
# odyssey-portal-backend.env.example.
KB_EMBED_URL=http://embed:8013
KB_SANTA_MODELS_TOKEN=

# ── kb/web ───────────────────────────────────────────────────────────────────
# DashScope (qwen3.7-flash) dùng KB_VLM_API_KEY; tra Google dùng KB_GEMINI_API_KEY —
# rỗng ⇒ bước grounding tự tắt (pipeline.open_deps), không ném.
KB_VLM_API_KEY=
KB_GEMINI_API_KEY=

# Trần lượt gọi Gemini grounding/ngày — mức miễn phí gemini-2.5-flash là 1.500/ngày.
# Cần xác nhận tier/billing của Google project trước khi bật key.
KB_WEB_GROUNDING_DAILY_CAP=1200

# Tầng trình duyệt (Playwright/Chromium, chỉ image `-crawl` có). `false` ⇒ trang chặn bot chỉ
# mang dấu needs_browser. Trần lượt/ngày theo tenant nằm ở tenant_data.kbweb_limits.browser_daily.
KB_WEB_BROWSER_ENABLED=true
